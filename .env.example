# ── LLM providers (at least one of Groq/OpenAI; Ollama optional) ──
GROQ_API_KEY=
OPENAI_API_KEY=
# GROQ_MODEL=qwen/qwen3.8-27b        # use whichever Groq model ID you have confirmed works
# OPENAI_MODEL=gpt-4o
# OLLAMA_MODEL=llama3                # only used when use_local_llm=true

# ── PubMed ──
PUBMED_EMAIL=you@example.com
# PUBMED_MIN_YEAR=2015

# ── API hardening (optional) ──
# API_KEY=change-me                  # if set, clients must send X-API-Key
# RATE_LIMIT_PER_MIN=30
# ALLOWED_ORIGINS=http://localhost:8501

# ── Verification / retrieval tuning ──
# NLI_MODEL=cross-encoder/nli-deberta-v3-small
# CLAIM_SUPPORT_THRESHOLD=0.50
# SUPPORTED_RATIO_MIN=0.70
# GUIDELINE_INTENT_BONUS=0.12
# FAITHFULNESS_DEBUG=1               # print per-claim scores in the API log
